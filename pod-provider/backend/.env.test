# Test-only non-secret baseline for isolated backend and live fixture launches.
# Runtime credentials remain supplied by each test/workflow through process.env.
SEMAPPS_INSTANCE_NAME=ActivityPods Test
SEMAPPS_INSTANCE_DESCRIPTION_EN=ActivityPods test provider
SEMAPPS_INSTANCE_DESCRIPTION_FR=Fournisseur ActivityPods de test
SEMAPPS_INSTANCE_OWNER=
SEMAPPS_INSTANCE_AREA=Test
SEMAPPS_AVAILABLE_LOCALES=en,fr
SEMAPPS_DEFAULT_LOCALE=en
SEMAPPS_ENABLE_GROUPS=false

SEMAPPS_HOME_URL=http://localhost:3000/
SEMAPPS_PORT=3000
SEMAPPS_FRONTEND_URL=http://localhost:5001/
SEMAPPS_SHAPE_REPOSITORY_URL=https://shapes.activitypods.org/
SEMAPPS_MAPBOX_ACCESS_TOKEN=
SEMAPPS_COLOR_PRIMARY=#899a44
SEMAPPS_COLOR_SECONDARY=#314a62

SEMAPPS_SPARQL_ENDPOINT=http://localhost:3040/
SEMAPPS_JENA_USER=admin
SEMAPPS_JENA_PASSWORD=admin
SEMAPPS_FUSEKI_BASE=../data/fuseki_test

SEMAPPS_REDIS_CACHE_URL=
SEMAPPS_QUEUE_SERVICE_URL=redis://localhost:6379/11
SEMAPPS_REDIS_TRANSPORTER_URL=redis://localhost:6379/12
SEMAPPS_REDIS_OIDC_PROVIDER_URL=redis://localhost:6379/13

SEMAPPS_COOKIE_SECRET=test-only-cookie-secret-not-for-production
SEMAPPS_FROM_EMAIL=test@example.invalid
SEMAPPS_FROM_NAME=activitypods-test
SEMAPPS_SMTP_HOST=localhost
SEMAPPS_SMTP_PORT=1025
SEMAPPS_SMTP_SECURE=false
SEMAPPS_SMTP_USER=
SEMAPPS_SMTP_PASS=

SEMAPPS_AUTH_RESERVED_USER_NAMES=sparql,auth,common,data,settings,localData,testData
SEMAPPS_AUTH_ACCOUNTS_DATASET=settings
