# Copy to .env for local development. Never commit populated .env files.

SEMAPPS_INSTANCE_NAME=MyPod.local
SEMAPPS_INSTANCE_DESCRIPTION_EN="A local provider for testing purposes"
SEMAPPS_INSTANCE_DESCRIPTION_FR="Un hébergeur local de Pod pour tester"
SEMAPPS_INSTANCE_OWNER=
SEMAPPS_INSTANCE_AREA="Local"
SEMAPPS_AVAILABLE_LOCALES=en,fr
SEMAPPS_DEFAULT_LOCALE=en
SEMAPPS_ENABLE_GROUPS=false

SEMAPPS_HOME_URL=http://localhost:3000/
SEMAPPS_PORT=3000
SEMAPPS_FRONTEND_URL=http://localhost:5001/
SEMAPPS_SHAPE_REPOSITORY_URL=https://shapes.activitypods.org/

# Frontend
SEMAPPS_MAPBOX_ACCESS_TOKEN=
SEMAPPS_COLOR_PRIMARY="#899a44"
SEMAPPS_COLOR_SECONDARY="#314a62"

# Triple store
SEMAPPS_SPARQL_ENDPOINT=http://localhost:3030/
SEMAPPS_JENA_USER=admin
# Required for local Fuseki. Set a local secret before starting docker-compose.
SEMAPPS_JENA_PASSWORD=
SEMAPPS_FUSEKI_BASE=../data/fuseki

# Redis
SEMAPPS_REDIS_CACHE_URL=
SEMAPPS_QUEUE_SERVICE_URL=redis://localhost:6379/1
SEMAPPS_REDIS_TRANSPORTER_URL=
SEMAPPS_REDIS_OIDC_PROVIDER_URL=redis://localhost:6379/2

# Generate strong random values for every secret. Do not reuse secrets across trust boundaries.
SEMAPPS_COOKIE_SECRET=

# Email
SEMAPPS_FROM_EMAIL=contact@example.invalid
SEMAPPS_FROM_NAME=activitypods
SEMAPPS_SMTP_HOST=localhost
SEMAPPS_SMTP_PORT=1025
SEMAPPS_SMTP_SECURE=false
SEMAPPS_SMTP_USER=
SEMAPPS_SMTP_PASS=

# Auth
SEMAPPS_AUTH_RESERVED_USER_NAMES="sparql,auth,common,data,settings,localData,testData"
# Required by the documented local external-delivery reconciliation profile.
SEMAPPS_AUTH_ACCOUNTS_DATASET=settings

# Backup
SEMAPPS_BACKUP_SERVER_HOST=
SEMAPPS_BACKUP_SERVER_USER=
SEMAPPS_BACKUP_SERVER_PASSWORD=
SEMAPPS_BACKUP_SERVER_PORT=

# Federation sidecar handoff. This token authenticates ActivityPods -> sidecar only.
SIDECAR_WEBHOOK_URL=http://fedify-sidecar:8080
SIDECAR_DELIVERY_HANDOFF_URL=http://fedify-sidecar:8080/webhook/outbox
SIDECAR_TOKEN=

# Internal signing API. This token authenticates sidecar -> ActivityPods signing calls only.
# It is intentionally distinct from SIDECAR_TOKEN and from password verification authority.
ACTIVITYPODS_TOKEN=

# Internal ATProto password verification. Do not reuse ACTIVITYPODS_TOKEN.
# Only the ATProto session/auth adapter should receive this capability.
ATPROTO_PASSWORD_VERIFY_TOKEN=

PDQ_HASH_SERVICE_BASE_URL=http://localhost:7070